# Only the Sepolia scripts read this file, and only the SEPOLIA_RPC_URL line:
#   node scripts/deploy-sepolia.js  --key <deployer key file> --env .env
#   node scripts/measure-sepolia.js --deployment results/sepolia_v1.1_deployment.json --log <log> --env .env
# The deployer key is a separate JSON file ({"address": ..., "privateKey": ...}) kept outside this repository.
# Never commit a real .env file or any key.

# An Ethereum Sepolia JSON-RPC endpoint (e.g. a public provider).
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
